# =============================================================================
# OfferWaleBaba Backend — Environment Template
# =============================================================================
# HOW TO USE:
#   1. Copy this file to ".env" in the same folder.
#   2. Replace every placeholder with the real value for that environment.
#   3. NEVER commit the real ".env" to git — only this template is safe to commit.
#
# ENVIRONMENT SWITCHING:
#   - Localhost dev:   NODE_ENV=development  (loose CORS, http cookies, verbose logs)
#   - Render staging:  NODE_ENV=production   + cross-site cookies (SameSite=none)
#   - Hostinger VPS:   NODE_ENV=production   + same-domain cookies (SameSite=lax recommended)
#
# RULE: code is identical across environments. Only values in this file change.
# =============================================================================


# -------------------------------------------------------------
# CORE
# -------------------------------------------------------------
NODE_ENV=development
PORT=8081
SHUTDOWN_TIMEOUT=5000
# Set to "true"|"false"|number-of-proxy-hops|"loopback".
# Localhost: false. Render / Hostinger behind Nginx: 1.
EXPRESS_TRUST_PROXY=false
# Optional: switch logger backend. Leave "false" for default console logger.
LOG_USE_WINSTON=false


# -------------------------------------------------------------
# DATABASE  (MongoDB)
# -------------------------------------------------------------
# Use SRV or full hostlist; pick whichever your network supports.
MONGO_DB_URI=mongodb://USER:PASSWORD@HOST1:27017,HOST2:27017,HOST3:27017/?ssl=true&authSource=admin&retryWrites=true&w=majority


# -------------------------------------------------------------
# AUTH / JWT
# -------------------------------------------------------------
# Generate long random strings per environment (32+ chars). NEVER reuse across envs.
JWT_SECRET=change-me-to-a-long-random-secret
REFRESH_TOKEN_SECRET=change-me-to-a-different-long-random-secret
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d


# -------------------------------------------------------------
# PUBLIC URLS  (no trailing slash)
# -------------------------------------------------------------
# Frontend origin used by:
#   - email/SMS deeplinks
#   - SEO canonical URL generation (seoUtils.js)
# Dev:        http://localhost:5173
# Production: https://your-frontend-domain.com
FRONTEND_URL=http://localhost:5173

# Public API base URL (used by wholesaler owner-review links + startup log banner).
# Dev:        http://localhost:8081
# Production: https://api.your-domain.com   (or https://your-domain.com if API on same host)
PUBLIC_API_BASE_URL=http://localhost:8081


# -------------------------------------------------------------
# CORS  (comma-separated, no trailing slashes)
# -------------------------------------------------------------
# In DEVELOPMENT (NODE_ENV=development) localhost origins are auto-allowed by the
# server — this list can be empty.
# In PRODUCTION every frontend origin MUST be listed here. Nothing is auto-allowed.
CORS_ALLOWED_ORIGINS=

# Extra origins allowed only on /api/wholesaler/owner-review/* (token-protected page).
OWNER_REVIEW_ALLOWED_ORIGINS=


# -------------------------------------------------------------
# COOKIES  (refresh token)
# -------------------------------------------------------------
# Parent domain for cross-subdomain SSO (e.g. ".your-domain.com").
# Leave EMPTY for pure-localhost dev.
COOKIE_DOMAIN=

# SameSite policy override. Valid: lax | strict | none. Leave empty to use defaults:
#   - development → lax
#   - production  → none  (required when frontend + API are on DIFFERENT sites)
# For same-root-domain production deployments, set COOKIE_SAMESITE=lax (stronger CSRF).
COOKIE_SAMESITE=


# -------------------------------------------------------------
# GOOGLE OAUTH
# -------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com


# -------------------------------------------------------------
# REDIS
# -------------------------------------------------------------
# Localhost (after installing redis-server): redis://localhost:6379
# Managed (Redis Cloud / Upstash):           redis://default:PASSWORD@HOST:PORT
REDIS_URL=redis://localhost:6379


# -------------------------------------------------------------
# EMAIL (Gmail SMTP via Nodemailer)
# -------------------------------------------------------------
EMAIL_USER=your-service-email@example.com
# App-password (NOT your account password). 16-char string from Google account.
EMAIL_PASSWORD=xxxx xxxx xxxx xxxx


# -------------------------------------------------------------
# SMS  (OTP delivery)
# -------------------------------------------------------------
# Supported providers: 2factor | fast2sms | twilio
SMS_PROVIDER=2factor
TWOFACTOR_API_KEY=your-2factor-api-key
# FAST2SMS_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=


# -------------------------------------------------------------
# WHOLESALER ACTIVATION
# -------------------------------------------------------------
# Page the approved applicant lands on (OTP + password setup).
# Dev:        http://localhost:5173/activate
# Production: https://wholesale.your-domain.com/activate
# REQUIRED in production. Server refuses to issue links if missing.
WHOLESALER_ACTIVATE_APP_URL=http://localhost:5173/activate

# WhatsApp number that owner approval notifications go to (digits only).
OWNER_WHATSAPP_NUMBER=919999999999

# Owner-review JWT signing (separate keyspace from main JWT).
OWNER_REVIEW_JWT_SECRET=change-me-or-reuse-jwt-secret
OWNER_REVIEW_TOKEN_EXPIRES=15m


# -------------------------------------------------------------
# STOREFRONT HOST ROUTING  (optional)
# -------------------------------------------------------------
# Maps incoming Host header → storefront ("ecomm" or "wholesale") when the
# x-storefront header is missing. Comma-separated hostnames (no protocol).
STOREFRONT_ECOMM_HOSTS=
STOREFRONT_WHOLESALE_HOSTS=


# -------------------------------------------------------------
# PAYMENTS  (Razorpay)
# -------------------------------------------------------------
# Dev/Staging: use rzp_test_* keys.
# Production:  switch to rzp_live_* keys before go-live.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=change-me-strong-secret


# -------------------------------------------------------------
# SHIPPING  (Shiprocket)
# -------------------------------------------------------------
SHIPROCKET_ENABLED=false
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1
STORE_PINCODE=000000
PICKUP_PINCODE=000000
SHIPROCKET_PICKUP_LOCATION=000000
SHIPROCKET_WEBHOOK_TOKEN=change-me-strong-secret
# Days within which a return can be requested after delivery; leave empty to disable.
RETURN_REQUEST_WINDOW_DAYS=2
# Used by demo flows only — must be FALSE in real production.
ALLOW_DEMO_MOCK_SHIPPING=false
ALLOW_CHECKOUT_DEMO_MOCK=false


# -------------------------------------------------------------
# MEDIA STORAGE
# -------------------------------------------------------------
# Modes: hybrid (R2 default, Cloudinary for return-proofs) | r2 | cloudinary
MEDIA_STORAGE_MODE=hybrid
MEDIA_PROVIDER_DEFAULT=r2
MEDIA_PROVIDER_RETURNS=cloudinary

# ---- Cloudinary (return proofs) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Cloudflare R2 (primary media) ----
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_REGION=auto
R2_PUBLIC_BASE_URL=
R2_FORCE_PATH_STYLE=true
R2_SIGNED_URLS_ENABLED=false
R2_SIGNED_URL_TTL_SECONDS=900

# Object key prefixes (optional but recommended)
R2_KEY_PREFIX_PRODUCTS=products
R2_KEY_PREFIX_CATEGORIES=categories
R2_KEY_PREFIX_DOCUMENTS=documents
R2_KEY_PREFIX_WHOLESALER=wholesaler/proofs
R2_KEY_PREFIX_TEMP=tmp


# -------------------------------------------------------------
# PRODUCT IMAGE PIPELINE  (Sharp)
# -------------------------------------------------------------
PRODUCT_IMAGE_MAX_WIDTH=1500
PRODUCT_IMAGE_WEBP_QUALITY=82
PRODUCT_IMAGE_WEBP_EFFORT=4
PRODUCT_IMAGE_PIPELINE_MODE=auto
PRODUCT_IMAGE_GENTLE_MAX_EDGE=1280
PRODUCT_IMAGE_GENTLE_MAX_BYTES=524288
PRODUCT_IMAGE_GENTLE_WEBP_QUALITY=93
PRODUCT_IMAGE_GENTLE_WEBP_EFFORT=2


# -------------------------------------------------------------
# ANALYTICS  (Google Analytics Data API — server-side)
# -------------------------------------------------------------
GA_PROPERTY_ID=
GOOGLE_APPLICATION_CREDENTIALS=./config/ga-credentials.json
# Frontend tracking IDs (kept for completeness; not consumed by server)
# GA_MEASUREMENT_ID=
# GA_STREAM_ID=


# -------------------------------------------------------------
# AI / NLP  (Hugging Face inference)
# -------------------------------------------------------------
HF_TOKEN=


# -------------------------------------------------------------
# OBSERVABILITY  (optional)
# -------------------------------------------------------------
# LOG_LEVEL=info
# DATADOG_API_KEY=
# SENTRY_DSN=
